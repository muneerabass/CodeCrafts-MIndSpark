# ---- depguard web (Next.js) ----
# Public URL of this web app (Better Auth base URL, links in emails).
PUBLIC_URL=http://localhost:3000
# Public URL of the machine API (CLI, agent, MCP). Only a fallback: setup guides prefer api_url/mcp_url from GET /api/v1/integrations.
PUBLIC_API_URL=http://localhost:8080
# Internal URL the web server uses to reach the Go API (never exposed to browsers).
API_URL=http://localhost:8080
# Shared with the Go API. HS256, >= 32 characters (the API refuses to start otherwise). e.g. `openssl rand -base64 48`
SERVICE_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Tenant domains are <org-slug>.<suffix>
TENANT_DOMAIN_SUFFIX=depguard.dev

# ---- Auth (Supabase) ----
# Sign-in (GitHub / Google OAuth, email magic link) runs through a Supabase project.
# Supabase dashboard → Project Settings → API. Configure OAuth providers in
# Supabase → Authentication → Providers; add <PUBLIC_URL>/auth/callback to the redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server-only, never expose to the browser
NEXT_PUBLIC_SUPABASE_GITHUB_ENABLED=1 # 0 hides the GitHub button
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=0 # 1 shows the Google button
# Separate database owned by the web app (orgs, members, invitations). Apply migrations: pnpm db:migrate
DATABASE_URL_WEB=postgres://depguard_web:depguard_web@localhost:5432/depguard_web
# Comma-separated emails that become platform super-admins (may sign in without an invitation).
SUPERADMIN_EMAILS=admin@example.com

# ---- Email (magic links, invitations). Mailpit in dev: SMTP on 1025, UI on 8025 ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="depguard <no-reply@depguard.local>"

# ---- Optional sidebar links ----
# DOCS_URL=/setup/integrations
# GITHUB_REPO_URL=https://github.com/depguard/depguard
# VIDEO_URL=
# SUPPORT_URL=https://github.com/depguard/depguard/issues

# ---- Development / tests only ----
# MOCK_API=1           serve fixtures instead of calling the Go API
# E2E_AUTH_BYPASS=1    fake signed-in user (ignored when NODE_ENV=production, i.e. next build/start)
