# Copy to deploy/.env and fill in. Never commit the real file.
APP_HOST=app.example.com
API_HOST=api.example.com
ACME_EMAIL=ops@example.com
TENANT_DOMAIN_SUFFIX=example.com
SUPERADMIN_EMAILS=you@example.com

# openssl rand -hex 32 for each of these
POSTGRES_PASSWORD=
DEPGUARD_APP_PASSWORD=
DEPGUARD_QUERY_PASSWORD=
DEPGUARD_WEB_PASSWORD=
SERVICE_JWT_SECRET=
BETTER_AUTH_SECRET=

# GitHub App (created via /admin → GitHub setup, or manually; see docs/DEPLOY.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.pem

# Supabase Auth (sign-in only — application data lives in local PostgreSQL).
# NEXT_PUBLIC_* are inlined into the web image at build time; the service-role
# key is runtime-only and must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_GITHUB_ENABLED=1
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=0

# OAuth login (GitHub OAuth App or the GitHub App's client credentials; Google optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (invitations, magic links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=depguard <no-reply@example.com>

BACKUP_KEEP_DAYS=14
VERSION=latest
