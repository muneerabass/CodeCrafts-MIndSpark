# Copy to deploy/.env and fill in. Never commit the real file.
# Public addresses. No domain yet? Use the server IP:
#   PUBLIC_URL=http://203.0.113.10          PUBLIC_API_URL=http://203.0.113.10:8080
# With domains: set APP_HOST/API_HOST too (Caddy then serves HTTPS automatically):
#   PUBLIC_URL=https://app.example.com      PUBLIC_API_URL=https://api.example.com
PUBLIC_URL=
PUBLIC_API_URL=
APP_HOST=
API_HOST=
TENANT_DOMAIN_SUFFIX=localhost
SUPERADMIN_EMAILS=you@example.com

# openssl rand -hex 32 for each of these
POSTGRES_PASSWORD=
DEPGUARD_APP_PASSWORD=
DEPGUARD_QUERY_PASSWORD=
DEPGUARD_WEB_PASSWORD=
SERVICE_JWT_SECRET=
BETTER_AUTH_SECRET=

# GitHub App (created via /admin → GitHub setup, or manually; see docs/DEPLOY.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.pem

# OAuth login (GitHub OAuth App or the GitHub App's client credentials; Google optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (invitations, magic links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=depguard <no-reply@example.com>

BACKUP_KEEP_DAYS=14
VERSION=latest
