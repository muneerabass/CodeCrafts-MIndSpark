# Without domains (APP_HOST/API_HOST empty): plain HTTP on the server IP —
#   dashboard http://<ip>/ and API http://<ip>:8080/.
# With domains set: automatic HTTPS (Let's Encrypt) for both hosts.

{$APP_HOST::80} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy web:3000
}

# Machine-facing API: GitHub webhooks, CLI/CI uploads, endpoint agent, MCP.
# /api/v1 (web-only, service JWT) and /admin are not exposed publicly.
{$API_HOST::8080} {
	encode zstd gzip
	header -Server
	@internal path /api/v1/* /admin/*
	respond @internal 404
	request_body {
		max_size 60MB
	}
	reverse_proxy api:8080
}
