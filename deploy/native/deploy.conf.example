# Copy to /etc/depguard/deploy.conf on the server (chmod 600). Never commit the real file.
APP_HOST=app.example.com            # web dashboard (DNS → server IP)
API_HOST=api.example.com            # GitHub webhooks, CLI, agents, MCP
ACME_EMAIL=ops@example.com          # Let's Encrypt notices
TENANT_DOMAIN_SUFFIX=example.com
SUPERADMIN_EMAILS=you@example.com   # comma-separated platform admins

# GitHub App (PR scanning). Private key goes to /etc/depguard/github-app.pem
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Supabase (sign-in only — all application data lives in local PostgreSQL set up by this installer).
# Do NOT set DATABASE_URL / DATABASE_OWNER_URL / DATABASE_QUERY_URL / DATABASE_URL_WEB here; the installer refuses Supabase DSNs.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_GITHUB_ENABLED=1
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=0

# Outgoing email for team invitations (optional; without it invite links are shown but not emailed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="depguard <no-reply@example.com>"

# AI (optional): powers the AI review of pull requests and the "Ask depguard" assistant.
# Without a key the rule-based review still runs and the assistant shows "AI is not configured".
# Preferred: a Gemini API key (Google AI Studio). Flash-Lite answers by default, Flash takes harder questions.
GEMINI_API_KEY=
DEPGUARD_GEMINI_MODELS=   # default: gemini-flash-lite-latest,gemini-flash-latest
# Or an Amazon Bedrock API key (used only when GEMINI_API_KEY is empty). Models are tried in order.
AWS_BEARER_TOKEN_BEDROCK=
DEPGUARD_AI_MODELS=   # e.g. eu-west-1/qwen.qwen3-coder-30b-a3b-v1:0,us-east-1/qwen.qwen3-coder-30b-a3b-v1:0
