[Unit]
Description=depguard worker (scans, feeds, GitHub jobs, guarddog)
After=depguard-api.service
Requires=postgresql.service

[Service]
User=depguard
Group=depguard
EnvironmentFile=/etc/depguard/depguard.env
Environment=WORKER_HEALTH_ADDR=127.0.0.1:8081
Environment=HOME=/var/lib/depguard
Environment=PATH=/opt/depguard/guarddog/bin:/usr/bin:/bin
ExecStart=/opt/depguard/bin/worker
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/depguard
MemoryMax=4G

[Install]
WantedBy=multi-user.target
