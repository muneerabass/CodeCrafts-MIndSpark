[Unit]
Description=depguard web app (Next.js)
After=depguard-api.service

[Service]
User=depguard
Group=depguard
WorkingDirectory=/opt/depguard/web
EnvironmentFile=/etc/depguard/web.env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1 NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
