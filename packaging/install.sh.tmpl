#!/bin/sh
# depguard CLI installer: downloads the binary for this machine.
#   curl -fsSL __BASE__/install.sh | sh
#   curl -fsSL __BASE__/install.sh | DEPGUARD_API_KEY=dg_... sh   # also signs in and connects your AI agents (MCP)
set -eu
BASE="__BASE__/downloads/cli"
os=$(uname -s | tr '[:upper:]' '[:lower:]')
arch=$(uname -m)
case "$arch" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) echo "depguard: unsupported architecture $arch" >&2; exit 1 ;; esac
case "$os" in linux|darwin) ;; *) echo "depguard: unsupported OS $os (on Windows use: npm i -g __BASE__/downloads/depguard-cli.tgz)" >&2; exit 1 ;; esac

on_path() { case ":$PATH:" in *":$1:"*) return 0 ;; esac; return 1; }
# Prefer a directory that is already on PATH, so `depguard` works right away.
dir="${DEPGUARD_INSTALL_DIR:-}"
if [ -z "$dir" ]; then
  for d in /usr/local/bin /opt/homebrew/bin "$HOME/.local/bin" "$HOME/bin"; do
    if on_path "$d" && [ -d "$d" ] && [ -w "$d" ]; then dir="$d"; break; fi
  done
fi
[ -n "$dir" ] || dir="$HOME/.local/bin"
mkdir -p "$dir"
tmp=$(mktemp)
echo "◆ depguard: downloading for $os/$arch…"
curl -fsSL "$BASE/depguard-$os-$arch" -o "$tmp"
chmod 755 "$tmp"
mv "$tmp" "$dir/depguard"
echo "◆ depguard: installed $("$dir/depguard" version) to $dir/depguard"

# Not on PATH yet: add it to every shell's startup file (once).
if ! on_path "$dir"; then
  line="export PATH=\"$dir:\$PATH\"  # depguard"
  files=""
  for f in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.profile" "$HOME/.bash_profile"; do [ -f "$f" ] && files="$files $f"; done
  case "${SHELL:-}" in */zsh) [ -f "$HOME/.zshrc" ] || files="$files $HOME/.zshrc" ;; esac
  [ -n "$files" ] || files="$HOME/.profile"
  for f in $files; do
    grep -qs "$dir" "$f" || printf '\n%s\n' "$line" >> "$f"
  done
  if command -v fish >/dev/null 2>&1; then
    mkdir -p "$HOME/.config/fish/conf.d"
    echo "fish_add_path -g $dir" > "$HOME/.config/fish/conf.d/depguard.fish"
  fi
  echo "◆ depguard: added $dir to your PATH (in$files). For this terminal run:"
  echo ""
  echo "    export PATH=\"$dir:\$PATH\""
  echo ""
fi

if [ -n "${DEPGUARD_API_KEY:-}" ]; then
  if [ -n "${DEPGUARD_API_URL:-}" ]; then
    "$dir/depguard" login --api-url "$DEPGUARD_API_URL" --api-key "$DEPGUARD_API_KEY"
  else
    "$dir/depguard" login --api-key "$DEPGUARD_API_KEY"
  fi
  "$dir/depguard" setup agents
else
  echo "  next:  depguard login --api-key dg_...   (API key from Settings → API Keys)"
  echo "         depguard setup agents             (connects Claude Code, Cursor, VS Code, Windsurf, Gemini CLI, Codex)"
  echo "         depguard init                     (in your project: guards npm/pip/go/cargo installs)"
fi
